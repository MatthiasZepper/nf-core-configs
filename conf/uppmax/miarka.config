// Used by https://github.com/nf-core/configs/blob/master/conf/uppmax.config
// Updates settings for Miarka

params {
    config_profile_description = 'UPPMAX (Miarka) cluster profile provided by nf-core/configs.'
    max_cpus                   = 48
    max_memory                 = 357.GB
    max_time                   = 480.h
}

// Hardware: https://www.uu.se/en/centre/uppmax/resources/clusters/miarka
process {
    resourceLimits = [
        cpus: 48,
        memory: 357.GB,
        time: 480.h,
    ]
    clusterOptions = {
        [
            "-A ${params.project}",
            (params.clusterOptions as String) ?: "",
            task.memory > 357.GB
                ? (task.memory <= 2000.GB ? '--mem 2TB' : '-c mem4TB')
                : "",
        ].findAll { opt -> opt }.join(" ")
    }

   // Send GPU tasks (e.g. Parabricks modules labelled `process_gpu`) to a node with GPU support.
    withLabel: process_gpu {
        clusterOptions = {
            [
                "-A ${params.project}",
                (params.clusterOptions as String) ?: "",
                "-p gpu --gres gpu:1",
            ].findAll { opt -> opt }.join(" ")
        }
    }
}
